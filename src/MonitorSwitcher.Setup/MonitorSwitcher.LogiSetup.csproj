<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath>..\..\artifacts\setup\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\MonitorSwitcher.Plugin\MonitorMenu.cs" Link="MonitorMenu.cs" />
    <Compile Include="..\MonitorSwitcher.Plugin\SavedMonitorBindings.cs" Link="SavedMonitorBindings.cs" />
    <Compile Include="..\MonitorSwitcher.Plugin\MonitorIcons.cs" Link="MonitorIcons.cs" />
    <Compile Include="..\MonitorSwitcher.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
